# Edge Function secrets (local: supabase functions serve --env-file supabase/functions/.env;
# deployed: supabase secrets set --env-file ...). See supabase/README.md.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# Placeholders only. Never commit real values.

# Comma-separated list of exact origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Random string used to salt IP hashes
IP_HASH_SALT=change-me
# Max create-order calls per IP per hour (positive integer)
RATE_LIMIT_PER_HOUR=5
# Optional: Retry-After seconds on 429
RETRY_AFTER_SECONDS=3600
# Optional: pin the platform header carrying the client IP (confirm on deploy)
CLIENT_IP_HEADER=

# Telegram bot (from @BotFather). Token is secret.
TELEGRAM_BOT_TOKEN=
# Random string, sent back by Telegram in X-Telegram-Bot-Api-Secret-Token (same value as setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Owner's numeric chat id; only this user/chat may confirm or reject
OWNER_CHAT_ID=
# Resend (owner notification email)
RESEND_API_KEY=
# Optional: verified sender, e.g. "Colibri <orders@your-domain>"; empty uses Resend's test sender
RESEND_FROM=
OWNER_EMAIL=
