# Edge Function secrets (local: supabase functions serve --env-file supabase/functions/.env).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# Placeholders only. Never commit real values.

# Comma-separated list of exact origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Random string used to salt IP hashes
IP_HASH_SALT=change-me
# Max create-order calls per IP per hour (positive integer)
RATE_LIMIT_PER_HOUR=5
# Optional: Retry-After seconds on 429
RETRY_AFTER_SECONDS=3600
# Optional: pin the platform header carrying the client IP (confirm on deploy)
CLIENT_IP_HEADER=

# S3 (not used yet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM=
OWNER_EMAIL=
